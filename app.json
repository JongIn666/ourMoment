{
  "expo": {
    "name": "ourMoment",
    "slug": "ourMoment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "ourmoment",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jonginlee.ourmoment"
    },
    "android": {
      "package": "com.jonginlee.ourmoment",
      "adaptiveIcon": {
        "backgroundColor": "#E6F0D0",
        "foregroundImage": "./assets/images/app-icon-android-fg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F0D0",
          "image": "./assets/images/logo.png",
          "imageWidth": 282
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
